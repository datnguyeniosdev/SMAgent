# Copy to .env and fill in. Never commit .env.

# --- Telegram (leave TELEGRAM_BOT_TOKEN empty to disable Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CONTROL_CHAT_ID=-1000000000000
# Reports go here: a channel, or the control group itself (single-group mode: no channel→group duplicates)
TELEGRAM_REPORT_CHANNEL_ID=-1000000000001
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_PROGRESS_UPDATES=false
# How updates arrive: polling (default, no public endpoint) or webhook (Telegram pushes to
# TELEGRAM_WEBHOOK_URL + /telegram/webhook). Empty URL in webhook mode: `agw dev` opens a cloudflared tunnel.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Passcode for important confirmations from Telegram (release, deploy, commit/push, git pull):
# tap ✅ on the question, then send it to the bot in a private chat (deleted at once); 3 wrong tries cancel it.
TELEGRAM_CONFIRM_PASSCODE=
# Linked Discussion Group of the report channel (replies there become task feedback).
TELEGRAM_DISCUSSION_CHAT_ID=

# --- REST control API (control endpoints return 503 while unset) ---
API_TOKEN=
# false: /mcp needs no token, but serves only this machine (loopback client, local Host, no foreign
# Origin), so local Claude Code sessions connect automatically. REST keeps API_TOKEN.
MCP_REQUIRE_TOKEN=true

# --- Storage / workspaces ---
DATA_DIR=var
# Git repository agents may modify (via isolated worktrees). Required for code workflows.
WORKSPACE_ROOT=
# Durable state (tasks, workflow runs, steps, approvals, events) under DATA_DIR.
STATE_DB=state.db
# Declarative gateway configuration (agents, capabilities, providers, routing, workflows, policies).
CONFIG_DIR=config

# --- Limits ---
MAX_ATTACHMENT_BYTES=20971520
TASK_TIMEOUT_S=1800
MAX_CONCURRENT_TASKS=2
ACTION_TTL_S=3600
MAX_RETRIES=2
MAX_FIX_ROUNDS=1
LOG_LEVEL=INFO

# --- OpenAI (enabled when key + model are set; pick a model your account has) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=

# --- Gemini (config/providers/models.yaml reads these; pick a model your key can use) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- fal.ai design/image provider (config/providers/models.yaml, task_type design_image) ---
FAL_KEY=
# Model id on fal, default fal-ai/flux/schnell
FAL_MODEL=

# --- DeepSeek (enabled when key is set) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_IMAGE_INPUT=false

HTTP_TIMEOUT_S=120

# --- Claude Code CLI runtime ---
CLAUDE_CODE_ENABLED=false
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_MODEL=
# Extra tools auto-approved for the implementer, permission-rule syntax:
CLAUDE_CODE_ALLOWED_TOOLS=
# MCP config JSON (e.g. Unity-MCP) passed with --mcp-config:
CLAUDE_CODE_MCP_CONFIG=
CLAUDE_CODE_MAX_BUDGET_USD=

# --- OpenCode runtime (start the server yourself: OPENCODE_SERVER_PASSWORD=... opencode serve) ---
OPENCODE_ENABLED=false
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_PASSWORD=
# "providerID/modelID"; empty = the server's default model
OPENCODE_MODEL=
# Shell commands OpenCode may run (prefix match, no shell operators); everything else is rejected.
OPENCODE_SHELL_ALLOWLIST=python3 -m pytest,pytest,git status,git diff

# --- Agent role preferences (comma-separated connector names) ---
IMPLEMENTER_PREFERENCE=claude_code
DESIGNER_PREFERENCE=openai,claude_code
REVIEWER_PREFERENCE=claude_code,openai

# --- QA: JSON map of name -> command (no shell). Example:
# QA_COMMANDS={"tests":"uv run pytest -q","lint":"uv run ruff check ."}
QA_COMMANDS={}
QA_TIMEOUT_S=900
QA_MAX_OUTPUT_BYTES=64000
# none = plain subprocess (NOT a sandbox) | docker = --network none container
QA_SANDBOX=none
QA_DOCKER_IMAGE=

# --- Plugins & policy ---
# Enabled domain plugins (module names under app/plugins, or dotted import paths).
PLUGINS=software,documents,data,media,unity
# Most permissions any plugin tool may hold, and what a workflow step is granted at runtime.
# mcp:execute (non-read-only MCP tools) is deliberately NOT granted by default.
PLUGIN_PERMISSIONS=workspace:read,workspace:write,process:execute,artifact:write,data:read,provider:image
TOOL_PERMISSIONS=workspace:read,workspace:write,process:execute,artifact:write,data:read,provider:image
# Per-plugin options (JSON), e.g. {"unity": {"asset_dir": "Assets/Generated"}}
PLUGIN_CONFIG={}
# MCP servers (JSON list). Only allowlisted tools are registered; read_only_tools need no approval.
# Example (verified locally): Claude Code as an MCP server, read-only tools only:
# MCP_SERVERS=[{"name":"claude_code","command":"claude","args":["mcp","serve"],"allowed_tools":["Read","Grep"],"read_only_tools":["Read","Grep"]}]
# Unity CLI MCP (tools appear only while a Unity Editor with the Pipeline package is connected):
# MCP_SERVERS=[{"name":"unity","command":"/Users/you/.unity/bin/unity","args":["mcp"],"allowed_tools":["editor_status"],"read_only_tools":["editor_status"]}]
MCP_SERVERS=[]
# Extra environment variables passed to QA commands (comma-separated), e.g. UNITY_PATH
QA_ENV_PASSTHROUGH=

# --- Asset validation (media / unity plugins) ---
ASSET_REQUIRE_ALPHA=true
ASSET_MAX_DIMENSION=4096
ASSET_POWER_OF_TWO=false
